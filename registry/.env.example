# Compass Registry - Environment Variables
# Copy this file to .env and fill in your Azure SQL credentials.
# The .env file is excluded from git. Never commit real credentials.

# Azure SQL Database connection
AZURE_SQL_SERVER=compass-registry-srv.database.windows.net
AZURE_SQL_DATABASE=compass-registry
AZURE_SQL_USERNAME=compass_import_user
AZURE_SQL_PASSWORD=

# ODBC Driver (Windows default shown - adjust for your OS)
# Windows: {ODBC Driver 18 for SQL Server}
# macOS/Linux: ODBC Driver 18 for SQL Server
AZURE_SQL_DRIVER={ODBC Driver 18 for SQL Server}
